{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run prepare:vst-worker:dev && npm run dev",
    "beforeBuildCommand": "npm run prepare:vst-worker:release && npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "publisher": "OSCMidi",
    "copyright": "Copyright © 2026 OSCMidi",
    "shortDescription": "Low-latency MIDI, RTP-MIDI, OSC, and VST bridge for Windows.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/vst-host-worker-x64",
      "binaries/vst-host-worker-x86"
    ],
    "targets": [
      "msi"
    ]
  },
  "productName": "OSCMidi",
  "version": "2.5.0",
  "identifier": "com.oscmidi.desktop",
  "plugins": {},
  "app": {
    "windows": [
      {
        "title": "OSC MIDI Bridge",
        "decorations": false,
        "transparent": true,
        "width": 1280,
        "height": 900,
        "minWidth": 1240,
        "minHeight": 860,
        "resizable": true,
        "center": true,
        "useHttpsScheme": true
      }
    ]
  }
}
